// Single-user, self-hosted schema.
// No User model, no per-user scoping — one deployment = one trader.
// Auth is handled entirely via env vars (see lib/auth.ts), not DB rows.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled — used by the running app
  directUrl = env("DIRECT_URL")     // unpooled — used only for migrations
}

generator client {
  provider = "prisma-client-js"
}

enum TradeType {
  BUY
  SELL
}

// Distinguishes "why I entered" (setups) from "what went wrong"
// (mistakes) and "how I felt" (emotions), so reports like "performance
// by strategy" and "which mistakes cost me money" can query separately
// instead of lumping every tag together.
enum TagCategory {
  SETUP
  MISTAKE
  EMOTION
}

model TradingAccount {
  id             String   @id @default(uuid())
  accountNumber  BigInt   // MT5 account numbers can exceed Int's 2.1B max
  brokerName     String
  currency       String   @default("USD")
  initialBalance Float    @default(10000.0)
  trades         Trade[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Prevents the EA from creating duplicate account rows if it re-registers
  @@unique([accountNumber, brokerName])
}

model Trade {
  id        String    @id @default(uuid())
  ticketId  BigInt    @unique // MetaTrader unique execution ticket
  symbol    String    // e.g. "EURUSD", "XAUUSD"
  type      TradeType
  lots      Float
  openPrice Float
  closePrice Float
  stopLoss  Float?
  takeProfit Float?

  // Keep these separate and explicit so P&L math can't silently double-count.
  // profit = gross P&L from price movement only (excludes commission/swap).
  // netProfit = profit - commission - swap, i.e. what actually hit the account.
  profit     Float
  commission Float @default(0.0)
  swap       Float  @default(0.0)
  netProfit  Float  // stored explicitly rather than computed on every read

  openTime  DateTime
  closeTime DateTime
  notes     String?
  rating    Int?     // execution discipline rating (1-5)

  // "Did I follow my trading plan on this trade?" — null means not yet
  // reviewed, distinct from false (reviewed and answer was "no").
  followedPlan Boolean?

  // true for trades entered by hand via the dashboard (paper trades,
  // or accounts not connected through the EA at all). These don't have
  // a real MT5 ticket, so ticketId is synthetically generated on
  // creation — isManual is what actually distinguishes them, not the
  // ticketId's value.
  isManual Boolean @default(false)

  tradingAccountId String
  account          TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)

  tags      TagOnTrade[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([tradingAccountId, openTime])
  @@index([symbol])
  @@index([closeTime])
}

model Tag {
  id       String      @id @default(uuid())
  name     String      // e.g. "Breakout", "FOMO Entry"
  category TagCategory
  trades   TagOnTrade[]

  // Same tag name can exist in different categories without colliding
  // (unlikely in practice, but avoids a subtle uniqueness bug)
  @@unique([name, category])
}

model TagOnTrade {
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
}
