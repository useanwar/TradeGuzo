# Neon.tech PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared secret your MT4/MT5 EA sends as the x-api-key header.
# Generate your own — do not reuse this example value.
EA_SECRET_KEY="change_me_to_a_long_random_string"

# Password for the web dashboard login screen.
DASHBOARD_PASSWORD="change_me"

# Random signing secret for the session JWT. Generate a fresh one per
# deployment, e.g.: openssl rand -base64 32
JWT_SECRET="change_me_to_a_long_random_string"
